# Vigil — AI-powered PR review
# Copy to .env and fill in the keys you need.

# GitHub token for local CLI use. It must be able to read the target PR;
# posting also needs pull-request and issue write access.
GITHUB_TOKEN=

# Model API keys — only need the one matching your --model choice
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Webhook server (for `vigil serve`)
WEBHOOK_SECRET=

# Email alerts for non-blocking specialists (e.g. Security)
# Leave blank to disable email alerts.
VIGIL_ALERT_EMAIL=you@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-app-password

# Optional LunaOS escalation delivery for alert-enabled findings.
LUNAOS_ESCALATION_URL=
ESCALATION_INGEST_TOKEN=

# Optional external review context. Either a command to execute or an
# http(s) endpoint; Vigil calls it once per review and injects its opaque
# text output into the prompt as untrusted evidence. Leave blank to disable.
# Never enable this for reviews of pull requests from forks.
VIGIL_CONTEXT_PROVIDER=
VIGIL_CONTEXT_LABEL=
VIGIL_CONTEXT_TOKEN=
VIGIL_CONTEXT_TIMEOUT=20
VIGIL_CONTEXT_MAX_CHARS=8000
